# Copy to .env and fill in. .env is git-ignored; this template is committed.

# PostgreSQL: any local password
POSTGRES_PASSWORD=

# Needed to create a family from the app. Without it, only the first family can be created.
# Generate with: openssl rand -hex 8
SETUP_CODE=

# The in-app assistant (Ask tab). Leave empty to run without it; everything else still works.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Public address of /mcp for the Claude connector, shown in the app's Settings (e.g. a Tailscale Funnel path)
# MCP_PUBLIC_URL=https://<pc>.<tailnet>.ts.net/baby-mcp

# Host port for the server (8080 to 8082 are taken on the home server)
# APP_PORT=8083
